{
  "release_zig_args": ["-Dstrip=true"],
  "floors": {
    "glibc": "2.28",
    "android_api": 24,
    "macos": 13,
    "ios": 14
  },
  "assets": {
    "libghostty-vt-linux-x64.so": {
      "zig_target": "x86_64-linux-gnu.2.28",
      "builder": "linux",
      "smoke": { "runner": "ubuntu-24.04", "dart": "mise" }
    },
    "libghostty-vt-linux-arm64.so": {
      "zig_target": "aarch64-linux-gnu.2.28",
      "builder": "linux",
      "smoke": { "runner": "ubuntu-24.04-arm", "dart": "linux-arm64" }
    },
    "ghostty-vt-windows-x64.dll": {
      "zig_target": "x86_64-windows-gnu",
      "builder": "linux",
      "smoke": { "runner": "windows-2025", "dart": "mise" }
    },
    "ghostty-vt-windows-arm64.dll": {
      "zig_target": "aarch64-windows-gnu",
      "builder": "linux",
      "smoke": { "runner": "windows-11-arm", "dart": "windows-arm64", "best_effort": true }
    },
    "libghostty-vt-android-arm64.so": { "zig_target": "aarch64-linux-android.24", "builder": "linux" },
    "libghostty-vt-android-arm.so": {
      "zig_target": "arm-linux-androideabi.24",
      "cpu": "baseline+vfp3d16+neon",
      "builder": "linux"
    },
    "libghostty-vt-android-x64.so": { "zig_target": "x86_64-linux-android.24", "builder": "linux" },
    "libghostty-vt-macos-arm64.dylib": {
      "zig_target": "aarch64-macos",
      "builder": "macos",
      "smoke": { "runner": "macos-15", "dart": "mise" }
    },
    "libghostty-vt-macos-x64.dylib": {
      "zig_target": "x86_64-macos",
      "builder": "macos",
      "smoke": { "runner": "macos-15-intel", "dart": "mise" }
    },
    "libghostty-vt-ios-arm64.dylib": { "zig_target": "aarch64-ios", "builder": "macos" },
    "libghostty-vt-ios-arm64-simulator.dylib": { "zig_target": "aarch64-ios-simulator", "builder": "macos" },
    "libghostty-vt-ios-x64-simulator.dylib": { "zig_target": "x86_64-ios-simulator", "builder": "macos" }
  }
}
