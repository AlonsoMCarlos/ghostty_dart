-                // Reset the memory to zero (and decommit it, where
-                // supported) so it can be reused.
-                _ = terminal_mem.decommit(.zero, item, page.memory.len);
+                // Keep one zeroed item resident as a hot spare. When
+                // scrollback is at its line limit, every new page is
+                // paired with pruning the oldest one; decommitting that
+                // item would make the next page fault in ~100 zeroed
+                // OS pages from the kernel. Zeroing the dirty prefix in
+                // place costs one memset instead. Further items are
+                // decommitted as before, so this keeps at most one
+                // extra item resident.
+                if (pool.pages.freeCount() == 0) {
+                    @memset(item[0..page.memory.len], 0);
+                } else {
+                    _ = terminal_mem.decommit(.zero, item, page.memory.len);
+                }
                 pool.pages.destroy(item);
             }
         },
