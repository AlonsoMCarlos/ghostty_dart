# Files kept out of the pub.dev archive. pub reads .pubignore instead of
# .gitignore when it exists in a directory, so repeat what .gitignore hides.
.dart_tool/
build/
pubspec_overrides.yaml

# Test-only assets: the pinned JetBrains Mono files and the Linux goldens are
# for this repo's CI, not for users (about 1.3 MB). doc/screenshot.png
# stays: pub.dev shows it (pubspec `screenshots`).
test/fonts/
test/goldens/
test/view/goldens/
test/**/failures/
integration_test/**/failures/
